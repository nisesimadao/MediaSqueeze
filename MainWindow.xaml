<Window x:Class="MediaSqueeze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaSqueeze" Height="430" Width="620"
        MinHeight="430" MinWidth="620"
        AllowDrop="True" Drop="Window_Drop" Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="TitleColorAnimation" RepeatBehavior="Forever">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(SolidColorBrush.Color)"
                                          Storyboard.TargetName="TitleBrush">
                <LinearColorKeyFrame Value="#ef4444" KeyTime="0:0:0"/>
                <LinearColorKeyFrame Value="#f59e0b" KeyTime="0:0:1"/>
                <LinearColorKeyFrame Value="#22c55e" KeyTime="0:0:2"/>
                <LinearColorKeyFrame Value="#06b6d4" KeyTime="0:0:3"/>
                <LinearColorKeyFrame Value="#6366f1" KeyTime="0:0:4"/>
                <LinearColorKeyFrame Value="#a855f7" KeyTime="0:0:5"/>
                <LinearColorKeyFrame Value="#ef4444" KeyTime="0:0:6"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="MediaSqueeze" FontSize="26" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,8,0,14">
            <TextBlock.Foreground>
                <SolidColorBrush x:Name="TitleBrush"/>
            </TextBlock.Foreground>
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnSelect" Grid.Column="0" Content="Select File…" Width="116"
                    Click="BtnSelect_Click"/>
            <TextBox x:Name="txtFilePath" Grid.Column="1" Margin="10,2,0,2"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Label Content="Mode" Target="{Binding ElementName=cmbMode}" FontWeight="Bold" Padding="0,0,0,2"/>
                <ComboBox x:Name="cmbMode" SelectionChanged="CmbMode_SelectionChanged">
                    <ComboBoxItem Content="Compress" Tag="compress" IsSelected="True"/>
                    <ComboBoxItem Content="Convert" Tag="convert"/>
                    <ComboBoxItem Content="Resize" Tag="resize"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="4,0">
                <Label x:Name="txtOptionLabel" Content="Quality" Target="{Binding ElementName=cmbQuality}"
                       FontWeight="Bold" Padding="0,0,0,2"/>
                <ComboBox x:Name="cmbQuality">
                    <ComboBoxItem Content="High" Tag="high"/>
                    <ComboBoxItem Content="Medium" Tag="medium" IsSelected="True"/>
                    <ComboBoxItem Content="Low" Tag="low"/>
                    <ComboBoxItem Content="10MB" Tag="10mb"/>
                </ComboBox>
                <ComboBox x:Name="cmbOutputFormat" Visibility="Collapsed" MaxDropDownHeight="330"/>
                <TextBlock x:Name="txtFixedOutput" Visibility="Collapsed"
                           Text="MP4 output" Margin="0,6,0,0" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <Label x:Name="txtScaleLabel" Content="Size" Target="{Binding ElementName=cmbScaleMode}"
                       FontWeight="Bold" Padding="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="76"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbScaleMode" Grid.Column="0" SelectionChanged="CmbScaleMode_SelectionChanged">
                        <ComboBoxItem Content="Original" Tag="original" IsSelected="True"/>
                        <ComboBoxItem Content="Percent" Tag="percent"/>
                        <ComboBoxItem Content="Width" Tag="width"/>
                        <ComboBoxItem Content="Height" Tag="height"/>
                    </ComboBox>
                    <TextBox x:Name="txtScaleValue" Grid.Column="1" Margin="8,0,0,0"
                             Text="50" VerticalContentAlignment="Center"
                             ToolTip="Percent, width, or height value"/>
                </Grid>
                <TextBlock x:Name="txtScaleHint" Margin="0,4,0,0" Foreground="Gray"
                           Text="Keeps aspect ratio."/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnRun" Content="Start" Width="116" Click="BtnRun_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="116" Margin="10,2,2,2"
                    Click="BtnCancel_Click" IsEnabled="False"/>
            <Button x:Name="btnOpenFolder" Content="Show Output" Width="116" Margin="10,2,2,2"
                    Click="BtnOpenFolder_Click" IsEnabled="False"/>
        </StackPanel>

        <ProgressBar x:Name="progressBar" Grid.Row="4" Height="20" Minimum="0" Maximum="100"/>

        <TextBox x:Name="txtStatus" Grid.Row="5" Margin="0,10,0,0"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Text="Select a file, or drop one here."/>
    </Grid>
</Window>
