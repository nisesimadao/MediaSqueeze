<Window x:Class="FFmpegConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaSqueeze - メディア変換＆圧縮ツール" Height="600" Width="800"
        MinHeight="500" MinWidth="700">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        
        <!-- ツールバー -->
        <ToolBar Grid.Row="0" Height="40">
            <Button Name="AddFilesBtn" Content="ファイル追加" Click="AddFiles_Click" Padding="10,5"/>
            <Separator/>
            <Button Name="ClearBtn" Content="クリア" Click="Clear_Click" Padding="10,5"/>
            <Separator/>
            <Button Name="ConvertBtn" Content="変換開始" Click="Convert_Click" Padding="15,5" 
                    Background="LightGreen" FontWeight="Bold"/>
        </ToolBar>
        
        <!-- ファイルリスト -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- ファイルリストビュー -->
            <GroupBox Grid.Column="0" Header="ファイルリスト" Margin="0,0,10,0">
                <ListView Name="FileListView" AllowDrop="True" 
                          Drop="FileListView_Drop" DragEnter="FileListView_DragEnter"
                          SelectionChanged="FileListView_SelectionChanged">
                    <ListView.Background>
                        <SolidColorBrush Color="LightBlue" Opacity="0.1"/>
                    </ListView.Background>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ファイル名" Width="200" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="形式" Width="80" DisplayMemberBinding="{Binding Format}"/>
                            <GridViewColumn Header="サイズ" Width="100" DisplayMemberBinding="{Binding FileSize}"/>
                            <GridViewColumn Header="状態" Width="100" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            
            <!-- 設定パネル -->
            <GroupBox Grid.Column="1" Header="変換設定">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <!-- 出力形式 -->
                        <Label Content="出力形式:" FontWeight="Bold"/>
                        <ComboBox Name="OutputFormatCombo" Margin="0,0,0,10">
                            <ComboBoxItem Content="MP4 (動画)" Tag="mp4"/>
                            <ComboBoxItem Content="AVI (動画)" Tag="avi"/>
                            <ComboBoxItem Content="MOV (動画)" Tag="mov"/>
                            <ComboBoxItem Content="MP3 (音声)" Tag="mp3"/>
                            <ComboBoxItem Content="WAV (音声)" Tag="wav"/>
                            <ComboBoxItem Content="FLAC (音声)" Tag="flac"/>
                            <ComboBoxItem Content="JPG (画像)" Tag="jpg"/>
                            <ComboBoxItem Content="PNG (画像)" Tag="png"/>
                            <ComboBoxItem Content="WebP (画像)" Tag="webp"/>
                        </ComboBox>
                        
                        <!-- 品質設定 -->
                        <Label Content="品質設定:" FontWeight="Bold"/>
                        <ComboBox Name="QualityCombo" Margin="0,0,0,10">
                            <ComboBoxItem Content="最高品質" Tag="high"/>
                            <ComboBoxItem Content="高品質" Tag="medium" IsSelected="True"/>
                            <ComboBoxItem Content="標準品質" Tag="normal"/>
                            <ComboBoxItem Content="低品質" Tag="low"/>
                            <ComboBoxItem Content="カスタム" Tag="custom"/>
                        </ComboBox>
                        
                        <!-- 解像度設定 -->
                        <Label Content="解像度:" FontWeight="Bold"/>
                        <ComboBox Name="ResolutionCombo" Margin="0,0,0,10">
                            <ComboBoxItem Content="元のサイズ" Tag="original" IsSelected="True"/>
                            <ComboBoxItem Content="1920x1080 (Full HD)" Tag="1920x1080"/>
                            <ComboBoxItem Content="1280x720 (HD)" Tag="1280x720"/>
                            <ComboBoxItem Content="854x480 (480p)" Tag="854x480"/>
                            <ComboBoxItem Content="640x360 (360p)" Tag="640x360"/>
                        </ComboBox>
                        
                        <!-- ビットレート -->
                        <Label Content="ビットレート (kbps):" FontWeight="Bold"/>
                        <TextBox Name="BitrateTextBox" Text="1000" Margin="0,0,0,10"/>
                        
                        <!-- 出力フォルダ -->
                        <Label Content="出力フォルダ:" FontWeight="Bold"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="OutputFolderTextBox" Grid.Column="0" IsReadOnly="True"/>
                            <Button Name="BrowseBtn" Grid.Column="1" Content="参照" 
                                    Click="Browse_Click" Margin="5,0,0,0" Padding="10,0"/>
                        </Grid>
                        
                        <!-- 詳細設定 -->
                        <Expander Header="詳細設定" Margin="0,10,0,0">
                            <StackPanel Margin="10">
                                <CheckBox Name="OverwriteCheckBox" Content="既存ファイルを上書き" Margin="0,5"/>
                                <CheckBox Name="DeleteOriginalCheckBox" Content="変換後に元ファイルを削除" Margin="0,5"/>
                                <Label Content="カスタムパラメータ:" FontWeight="Bold" Margin="0,10,0,0"/>
                                <TextBox Name="CustomParamsTextBox" Height="60" TextWrapping="Wrap" 
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        
        <!-- プログレスバー -->
        <Grid Grid.Row="2" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Name="ProgressBar" Grid.Column="0" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock Name="ProgressText" Grid.Column="1" VerticalAlignment="Center" 
                       Margin="10,0,0,0" Text="待機中"/>
        </Grid>
        
        <!-- ログ出力 -->
        <GroupBox Grid.Row="3" Header="ログ" Margin="10">
            <TextBox Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"/>
        </GroupBox>
    </Grid>
</Window>